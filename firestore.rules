rules_version = '2';

// ────────────────────────────────────────────────────────────────
//  Live Comments — Firestore Security Rules
//
//  หลักการ:
//   • อ่านได้สาธารณะ (เป็นห้องแชทสด) แต่ "เขียน" ต้องผ่านการ validate ทุก field
//   • client เขียน DB ตรงได้ แต่ rules บังคับ schema/ขนาด/เวลา/เจ้าของ
//   • admin (ตาม uid allowlist) เท่านั้นที่ลบ/ปิดห้อง/ปักหมุดได้
//   • Reaction data ย้ายไป RTDB แล้ว — Firestore ไม่เก็บ reactionCounts อีกต่อไป
// ────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔑 ใส่ UID ของบัญชี admin ที่นี่ (ดูวิธีหาใน SETUP.md)
    function adminUids() {
      return [
        '3X214jaNe2QQs2BPkE5EugDHy0C3'
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid in adminUids();
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();

      // ── ข้อความ ────────────────────────────────────────────────
      match /messages/{msgId} {
        allow read: if true;

        allow create: if isSignedIn()
                      && isValidNewMessage()
                      && notRateLimited();

        // admin แก้ได้ทุกอย่าง (pin, status) — user ทั่วไปแก้ไม่ได้
        allow update: if isAdmin();

        allow delete: if isAdmin();

        function isValidNewMessage() {
          let d = request.resource.data;
          return d.uid == request.auth.uid
            && d.text is string  && d.text.size() > 0 && d.text.size() <= 200
            && d.name is string  && d.name.size() > 0 && d.name.size() <= 20
            && d.color is string && d.color.matches('#[0-9a-fA-F]{6}')
            && d.status == 'visible'
            && d.createdAt == request.time
            && d.expireAt is timestamp
            && d.expireAt > request.time
            && d.expireAt < request.time + duration.value(2, 'd')
            && d.keys().hasOnly([
                 'uid','name','color','text','createdAt','status','expireAt'
               ]);
        }
      }

      // Reaction subcollection — legacy (ยังเปิด read/delete เพื่อ adminClear ล้างของเก่า)
      match /messages/{msgId}/reactions/{uid} {
        allow read: if true;
        allow create, update: if false; // ย้ายไป RTDB แล้ว
        allow delete: if isSignedIn()
                      && (uid == request.auth.uid || isAdmin());
      }

      // Report (ยังใช้ Firestore เหมือนเดิม)
      match /messages/{msgId}/reports/{uid} {
        allow read: if isAdmin();
        allow create: if isSignedIn()
                      && uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['reportedAt','reporterUid'])
                      && request.resource.data.reporterUid == request.auth.uid
                      && request.resource.data.reportedAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // best-effort slow-mode
      match /rateLimits/{uid} {
        allow read:  if isSignedIn() && uid == request.auth.uid;
        allow write: if isSignedIn() && uid == request.auth.uid
                     && request.resource.data.nextAllowed is timestamp
                     && request.resource.data.nextAllowed > request.time;
      }

      function notRateLimited() {
        let rl = /databases/$(database)/documents/rooms/$(roomId)/rateLimits/$(request.auth.uid);
        return !exists(rl) || get(rl).data.nextAllowed <= request.time;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
