# Firebase web config (เป็นค่า public — ความปลอดภัยพึ่ง Security Rules + App Check)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับโปรเจกต์ของคุณ:  cp .env.example .env
VITE_FIREBASE_API_KEY=AIzaSyAkM-kBPSeuABLv_UeZnz2YLrn0pqbJw4M
VITE_FIREBASE_AUTH_DOMAIN=live-comments-60609.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://live-comments-60609-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=live-comments-60609
VITE_FIREBASE_STORAGE_BUCKET=live-comments-60609.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=104358541443
VITE_FIREBASE_APP_ID=1:104358541443:web:f49a3fb3a23bb3dbaf03b6

# (ออปชัน) App Check — ใส่ reCAPTCHA v3 site key เพื่อเปิดใช้งาน
VITE_RECAPTCHA_SITE_KEY=

# (ออปชัน) Sentry — error monitoring (สร้างโปรเจกต์ที่ sentry.io แล้วคัดลอก DSN)
# ถ้าว่าง Sentry จะไม่ถูกโหลดเลย (zero bundle cost)
VITE_SENTRY_DSN=
