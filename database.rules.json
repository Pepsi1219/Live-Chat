{
  "rules": {
    "status": {
      "$roomId": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (data.exists() && !newData.exists() && data.child('lastSeen').val() < (now - 60000)))",
          ".validate": "!newData.exists() || (newData.hasChildren(['online','name','lastSeen']) && newData.child('name').isString() && newData.child('name').val().length <= 20)"
        }
      }
    },

    "reactions": {
      "$roomId": {
        ".read": true,
        "$msgId": {
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'like' || newData.val() === 'love' || newData.val() === 'clap'))"
            }
          },
          "counts": {
            "$type": {
              ".write": "auth != null && ($type === 'like' || $type === 'love' || $type === 'clap')",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        }
      }
    }
  }
}
